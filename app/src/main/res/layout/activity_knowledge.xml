<?xml version='1.0' encoding='utf-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screen_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/page">
    <include layout="@layout/view_toolbar" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/tv_chapter_intro"
            style="@style/Heading"
            android:text="" />
        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:singleLine="true"
            android:inputType="text"
            android:hint="搜索全部章节标题、正文与代码" />
    </LinearLayout>
    <TextView
        android:id="@+id/tv_knowledge_empty"
        style="@style/Caption"
        android:text="没有匹配的知识点"
        android:gravity="center" />
    <ListView
        android:id="@+id/lv_knowledge"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp" />
    <include layout="@layout/view_identity" />
</LinearLayout>